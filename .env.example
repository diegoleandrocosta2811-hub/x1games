# Variáveis de ambiente da X1 Games e Eletrônicos
# Copie este arquivo para .env.local e preencha com dados reais.

# URL canônica do site (sem barra no final). Ex.: https://www.dominio.com.br
NEXT_PUBLIC_SITE_URL=

# WhatsApp com DDI + DDD + número, somente dígitos. Ex.: 5515999999999
NEXT_PUBLIC_WHATSAPP=

# Analytics — NÃO preencher com IDs falsos. Scripts ainda não são carregados.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=
